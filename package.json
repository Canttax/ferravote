{
  "name": "ferravote",
  "version": "0.1.0",
  "description": "Vote d'assemblée générale vérifiable sur le XRP Ledger (Testnet) avec un jeton MPT non transférable",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-testnet.js",
    "wallets": "node ledger/wallets.js",
    "create": "node ledger/create-ballot.js",
    "authorize": "node ledger/authorize.js",
    "distribute": "node ledger/distribute.js",
    "vote": "node ledger/vote.js",
    "close": "node ledger/close.js",
    "tally": "node tally/cli.js",
    "demo": "node scripts/demo.js",
    "demo:sim": "node scripts/demo.js --sim",
    "web": "node web/server.js",
    "web:sim": "node web/server.js --sim",
    "test": "node --test test/*.test.js",
    "sim:reset": "node sim/reset.js"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "xrpl": "^5.3.0"
  }
}
