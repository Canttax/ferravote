# Copier ce fichier en .env (ou lancer npm run wallets qui le remplit tout seul).
# .env est dans .gitignore : AUCUNE seed ne doit être poussée sur GitHub.
# Comptes de TEST uniquement, jamais de seed Mainnet.

# Mode : testnet (par défaut) ou simulation (ledger simulé en local, voir sim/)
XRPL_MODE=testnet

# Serveurs Testnet essayés dans l'ordre, séparés par des virgules.
# Si le Wi-Fi bloque le port 51233, les deux suivants passent par le port 443.
XRPL_NETWORK=wss://s.altnet.rippletest.net:51233,wss://testnet.xrpl-labs.com,wss://testnet.honeycluster.io
XRPL_FAUCET=faucet.altnet.rippletest.net
XRPL_EXPLORER=https://testnet.xrpl.org

# Seed du compte urne (émetteur du jeton de vote)
URNE_SEED=

# Seeds des électeurs de test, séparées par des virgules
ELECTEUR_SEEDS=

# Wallet financé mais jamais autorisé, pour montrer qu'il ne peut pas voter
INTRUS_SEED=
